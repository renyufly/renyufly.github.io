---
import ThemeBlogArchiveHeader from '@navfolio/theme-default/components/BlogArchiveHeader.astro';

interface Props {
  kicker?: string;
  title?: string;
  subtitle?: string;
  note?: string;
  zh?: { kicker?: string; title?: string; subtitle?: string; note?: string };
}

const { kicker, title, subtitle, note, zh } = Astro.props;
---

<div data-locale-copy="en">
  <ThemeBlogArchiveHeader kicker={kicker} title={title} subtitle={subtitle} note={note} />
</div>
{
  zh && (
    <div data-locale-copy="zh-CN">
      <ThemeBlogArchiveHeader
        kicker={zh.kicker ?? kicker}
        title={zh.title ?? title}
        subtitle={zh.subtitle ?? subtitle}
        note={zh.note ?? note}
      />
    </div>
  )
}
