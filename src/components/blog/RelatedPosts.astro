---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../FormattedDate.astro';
import SmartImage from '../SmartImage.astro';
import { getSiteConfig } from '../../data/site';
import { getUiText, getUiTextForLanguage } from '../../utils/ui-text';
import '@navfolio/theme-default/styles/blog-related-posts.css';

interface Props {
  posts: CollectionEntry<'blog'>[];
  class?: string;
}

const { posts, class: className } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteConfig = await getSiteConfig();
const ui = getUiText(siteConfig);
const zhUi = getUiTextForLanguage('zh-CN');

function withBase(href: string) {
  if (href === '/') {
    return `${basePath}/` || '/';
  }

  return `${basePath}${href.startsWith('/') ? href : `/${href}`}`;
}
---

<aside class:list={['related-posts', 'blog-card', className]}>
  <h2>
    <span data-locale-copy="en">{ui.article.moreFromSite(siteConfig.site.title)}</span><span
      data-locale-copy="zh-CN">{zhUi.article.moreFromSite(siteConfig.site.title)}</span
    >
  </h2>
  <div class="related-list">
    {
      posts.map((post) => (
        <a
          class:list={[{ 'has-thumbnail': Boolean(post.data.heroImage) }]}
          href={withBase(`/blog/${post.id}/`)}
        >
          {post.data.heroImage && (
            <SmartImage width={88} height={64} src={post.data.heroImage} alt="" />
          )}
          <span>
            <strong>{post.data.title}</strong>
            <small>
              <FormattedDate date={post.data.date} />
            </small>
          </span>
        </a>
      ))
    }
  </div>
</aside>
