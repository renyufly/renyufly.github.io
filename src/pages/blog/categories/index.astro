---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import BackLink from '../../../components/blog/BackLink.astro';
import BlogTopNav from '../../../components/blog/BlogTopNav.astro';
import CategoryCard from '../../../components/blog/CategoryCard.astro';
import { getSiteConfig } from '../../../data/site';
import { getAllCategories } from '../../../utils/content-groups';
import { getUiText, getUiTextForLanguage } from '../../../utils/ui-text';

const siteConfig = await getSiteConfig();
const { site, theme, pages } = siteConfig;
const palette = theme.palette;
const pageMeta = pages.blog.categories;
const categories = getAllCategories(await getCollection('blog', ({ data }) => !data.draft));
const ui = getUiText(siteConfig);
const zhUi = getUiTextForLanguage('zh-CN');
---

<!doctype html>
<html lang={ui.locale} data-palette={palette}>
  <head>
    <BaseHead title={`${pageMeta.title} | ${site.title}`} description={pageMeta.note} />
    <style>
      main {
        width: min(100%, var(--layout-shell-width));
        max-width: none;
        padding: 118px var(--layout-page-gutter) var(--layout-page-bottom);
      }

      .category-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
      }

      .empty-note {
        max-width: 620px;
        margin: 0;
        color: var(--paper-ink-soft);
        font-family: var(--font-serif-cn);
        font-size: 1rem;
        line-height: 1.75;
      }

      @media (max-width: 900px) {
        .category-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 720px) {
        main {
          padding-top: 88px;
        }

        .category-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <BlogTopNav />
    <main data-pagefind-body>
      <span data-locale-copy="en"><BackLink href="/blog/" label={ui.groups.back} /></span><span
        data-locale-copy="zh-CN"><BackLink href="/blog/" label={zhUi.groups.back} /></span
      >
      <header class="archive-hero archive-header-shared page-header-spacing">
        <div class="archive-header-main">
          <p class="archive-kicker">
            <span data-locale-copy="en">{pageMeta.kicker}</span><span data-locale-copy="zh-CN"
              >浏览文章</span
            >
          </p>
          <h1 class="archive-title">
            <span data-locale-copy="en">{pageMeta.title}</span><span data-locale-copy="zh-CN"
              >分类</span
            >
          </h1>
        </div>
        <div class="archive-copy">
          {pageMeta.subtitle && <p class="archive-subtitle">{pageMeta.subtitle}</p>}
          {
            pageMeta.note && (
              <p class="archive-note">
                <>
                  <span data-locale-copy="en">{pageMeta.note}</span>
                  <span data-locale-copy="zh-CN">按主题浏览文章。</span>
                </>
              </p>
            )
          }
        </div>
      </header>

      {
        categories.length > 0 ? (
          <section class="category-grid" aria-label={ui.groups.categories}>
            {categories.map((category) => (
              <CategoryCard name={category.name} slug={category.slug} count={category.count} />
            ))}
          </section>
        ) : (
          <p class="empty-note">
            <>
              <span data-locale-copy="en">{ui.groups.emptyCategories}</span>
              <span data-locale-copy="zh-CN">{zhUi.groups.emptyCategories}</span>
            </>
          </p>
        )
      }
    </main>
    <Footer />
  </body>
</html>
